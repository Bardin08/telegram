---
whiskers:
  version: "^2.9.0"
  matrix:
    - flavor
  filename: "src/{{ flavor.identifier }}/catppuccin-{{ flavor.identifier }}-crema.tgios-theme"
---
name: Catppuccin {{ flavor.name }} Crema
dark: {{ if(cond=flavor.dark, t="true", f="false") }}
basedOn: {{ if(cond=flavor.dark, t="night", f="day") }}
intro:
  statusBar: {{ if(cond=flavor.dark, t="white", f="black") }}
  primaryText: {{ text.hex }}
  accentText: {{ green.hex }}
  disabledText: 575b55
  startButton: {{ green.hex }}
  dot: {{ subtext1.hex }}
passcode:
  bg:
    top: {{ surface2.hex }}
    bottom: {{ base.hex }}
  button: {{ surface0.hex }}
root:
  statusBar: {{ if(cond=flavor.dark, t="white", f="black") }}
  tabBar:
    background: {{ surface0.hex }}
    separator: {{ crust.hex }}
    icon: {{ overlay1.hex }}
    selectedIcon: {{ green.hex }}
    text: {{ overlay1.hex }}
    selectedText: {{ green.hex }}
    badgeBackground: {{ red.hex }}
    badgeStroke: {{ red.hex }}
    badgeText: {{ crust.hex }}
  navBar:
    button: {{ green.hex }}
    disabledButton: 575b55
    primaryText: {{ text.hex }}
    secondaryText: {{ subtext1.hex }}
    control: {{ subtext1.hex }}
    accentText: {{ green.hex }}
    background: {{ surface0.hex }}
    opaqueBackground: {{ surface0.hex }}
    separator: {{ crust.hex }}
    badgeFill: {{ red.hex }}
    badgeStroke: {{ red.hex }}
    badgeText: {{ crust.hex }}
    segmentedBg: {{ base.hex }}
    segmentedFg: {{ surface0.hex }}
    segmentedText: {{ text.hex }}
    segmentedDivider: 80{{ text.hex }}
    clearButtonBackground: 1a{{ text.hex }}
    clearButtonForeground: {{ text.hex }}
  searchBar:
    background: {{ surface0.hex }}
    accent: {{ green.hex }}
    inputFill: {{ base.hex }}
    inputText: {{ text.hex }}
    inputPlaceholderText: {{ subtext1.hex }}
    inputIcon: {{ subtext1.hex }}
    inputClearButton: {{ subtext1.hex }}
    separator: {{ base.hex }}
  keyboard: {{ if(cond=flavor.dark, t="dark", f="light") }}
list:
  blocksBg: {{ base.hex }}
  modalBlocksBg: {{ mantle.hex }}
  modalPlainBg: {{ mantle.hex }}
  plainBg: {{ base.hex }}
  primaryText: {{ text.hex }}
  secondaryText: 80{{ text.hex }}
  disabledText: 80{{ text.hex }}
  accent: {{ green.hex }}
  highlighted: {{ green.hex }}
  destructive: {{ red.hex }}
  placeholderText: 80{{ text.hex }}
  itemBlocksBg: {{ surface0.hex }}
  itemModalBlocksBg: {{ surface0.hex }}
  itemHighlightedBg: {{ surface0.hex }}
  blocksSeparator: {{ crust.hex }}
  plainSeparator: {{ crust.hex }}
  disclosureArrow: 80{{ text.hex }}
  sectionHeaderText: {{ surface2.hex }}
  freeText: {{ surface2.hex }}
  freeTextError: {{ red.hex }}
  freeTextSuccess: {{ green.hex }}
  freeMonoIcon: {{ surface2.hex }}
  switch:
    frame: 80{{ text.hex }}
    handle: {{ crust.hex }}
    content: {{ green.hex }}
    positive: {{ green.hex }}
    negative: {{ red.hex }}
  disclosureActions:
    neutral1:
      bg: {{ green.hex }}
      fg: ffffff
    neutral2:
      bg: {{ peach.hex }}
      fg: ffffff
    destructive:
      bg: {{ red.hex }}
      fg: ffffff
    constructive:
      bg: {{ green.hex }}
      fg: ffffff
    accent:
      bg: {{ green.hex }}
      fg: ffffff
    warning:
      bg: {{ peach.hex }}
      fg: ffffff
    inactive:
      bg: {{ base.hex }}
      fg: {{ text.hex }}
  check:
    bg: {{ green.hex }}
    stroke: 80{{ text.hex }}
    fg: {{ crust.hex }}
  controlSecondary: 80{{ text.hex }}
  freeInputField:
    bg: {{ surface0.hex }}
    stroke: {{ surface0.hex }}
    placeholder: 80{{ text.hex }}
    primary: {{ text.hex }}
    control: 80{{ text.hex }}
  freePlainInputField:
    bg: {{ surface0.hex }}
    stroke: {{ surface0.hex }}
    placeholder: {{ overlay2.hex }}
    primary: {{ text.hex }}
    control: {{ overlay2.hex }}
  mediaPlaceholder: {{ base.hex }}
  scrollIndicator: 80{{ text.hex }}
  pageIndicatorInactive: 66{{ text.hex }}
  inputClearButton: {{ subtext1.hex }}
  itemBarChart:
    color1: {{ green.hex }}
    color2: 80{{ text.hex }}
    color3: {{ base.hex }}
  itemInputField:
    bg: {{ mantle.hex }}
    stroke: {{ mantle.hex }}
    placeholder: {{ overlay1.hex }}
    primary: {{ text.hex }}
    control: {{ overlay1.hex }}
chatList:

          reactionInactiveFg: {{ crust.hex }}
          reactionActiveBg: {{ crust.hex }}
          reactionActiveFg: {{ green.hex }}
          reactionInactiveMediaPlaceholder: 19{{ crust.hex }}
          reactionActiveMediaPlaceholder: 19{{ crust.hex }}
        withoutWp:
          bg: {{ green.hex }}
          gradientBg: {{ green.hex }}
          highlightedBg: {{ green.hex }}
          stroke: clear
          reactionInactiveBg: 26{{ crust.hex }}
          reactionInactiveFg: {{ crust.hex }}
          reactionActiveBg: {{ crust.hex }}
          reactionActiveFg: {{ green.hex }}
          reactionInactiveMediaPlaceholder: 19{{ crust.hex }}
          reactionActiveMediaPlaceholder: 19{{ crust.hex }}
      primaryText: {{ crust.hex }}
      secondaryText: 80{{ crust.hex }}
      linkText: {{ crust.hex }}
      linkHighlight: 80{{ text.hex }}
      scam: {{ crust.hex }}
      textHighlight: {{ peach.hex }}
      accentText: {{ crust.hex }}
      accentControl: {{ crust.hex }}
      accentControlDisabled: 80{{ crust.hex }}
      mediaActiveControl: {{ crust.hex }}
      mediaInactiveControl: 80{{ crust.hex }}
      mediaControlInnerBg: {{ green.hex }}
      pendingActivity: 80{{ crust.hex }}
      fileTitle: {{ crust.hex }}

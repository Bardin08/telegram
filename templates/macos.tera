---
whiskers:
  version: "^2.9.0"
  matrix:
    - flavor
  filename: "src/{{ flavor.identifier }}/catppuccin-{{ flavor.identifier }}-crema.palette"
---
{#- Telegram for macOS palette.
    Parser notes (Telegram-Mac/ParseAppearanceColors.swift):
    - one `key = value` per line, `//` lines are comments (a comment must be on its own line);
    - colors are `#rrggbb`; alpha is written as `#rrggbb:0.5` (8-digit hex is NOT supported,
      only the last 6 hex digits are read);
    - every key that is missing falls back to `parent`. -#}
{%- set sel_bg = if(cond=flavor.dark, t=surface1.hex, f=green.hex) -%}
{#- Latte's green is too light for text on top of it, so the light flavor gets a pale green
    outgoing bubble with dark text and blue links instead of a solid green bubble. -#}
{%- set out_bg = if(cond=flavor.dark, t=green.hex, f=green | mix(color=base, amount=0.3) | get(key="hex")) -%}
{%- set out_hl = if(cond=flavor.dark, t=teal.hex, f=green | mix(color=base, amount=0.45) | get(key="hex")) -%}
{%- set on_out = if(cond=flavor.dark, t=crust.hex, f=text.hex) -%}
{%- set on_accent = if(cond=flavor.dark, t=crust.hex, f=base.hex) -%}
{%- set lnk = if(cond=flavor.dark, t=green.hex, f=blue.hex) -%}
//metadata
name = Catppuccin {{ flavor.name }} Crema
shortname = ctp_{{ flavor.identifier }}_crema
isDark = {{ if(cond=flavor.dark, t=1, f=0) }}
tinted = {{ if(cond=flavor.dark, t=1, f=0) }}
//Fallback for parameters which didn't define. Available values: day, dayClassic, dark, nightAccent
parent = {{ if(cond=flavor.dark, t="dark", f="day") }}
copyright = Catppuccin

//Variables
basicAccent = #{{ green.hex }}
background = #{{ base.hex }}
text = #{{ text.hex }}
grayText = #{{ subtext0.hex }}
link = #{{ lnk }}
accent = #{{ green.hex }}
redUI = #{{ red.hex }}
greenUI = #{{ green.hex }}
blackTransparent = #{{ crust.hex }}:0.6
grayTransparent = #{{ surface0.hex }}:0.6
grayUI = #{{ mantle.hex }}
darkGrayText = #{{ subtext0.hex }}
accentSelect = #{{ sel_bg }}
selectText = #{{ green.hex }}:0.35
border = #{{ crust.hex }}
grayBackground = #{{ surface0.hex }}
grayForeground = #{{ surface0.hex }}
grayIcon = #{{ overlay2.hex }}
accentIcon = #{{ green.hex }}
badgeMuted = #{{ overlay1.hex }}
badge = #{{ green.hex }}
indicatorColor = #{{ text.hex }}
selectMessage = #{{ surface0.hex }}:0.5
premium = #{{ mauve.hex }}
vibrant = #{{ overlay0.hex }}:0.1

//Code
monospacedPre = #{{ peach.hex }}
monospacedCode = #{{ peach.hex }}
monospacedPreBubble_incoming = #{{ peach.hex }}
monospacedPreBubble_outgoing = #{{ on_out }}
monospacedCodeBubble_incoming = #{{ peach.hex }}
monospacedCodeBubble_outgoing = #{{ on_out }}

//Bubbles
bubbleBackground_incoming = #{{ surface0.hex }}
bubbleBackgroundTop_outgoing = #{{ out_bg }}
bubbleBackgroundBottom_outgoing = #{{ out_bg }}
bubbleBorder_incoming = #{{ surface0.hex }}
bubbleBorder_outgoing = #{{ out_bg }}
bubbleBackgroundHighlight_incoming = #{{ surface1.hex }}
bubbleBackgroundHighlight_outgoing = #{{ out_hl }}
textBubble_incoming = #{{ text.hex }}
textBubble_outgoing = #{{ on_out }}
selectTextBubble_incoming = #{{ green.hex }}:0.35
selectTextBubble_outgoing = #{{ on_out }}:0.25
grayTextBubble_incoming = #{{ subtext0.hex }}
grayTextBubble_outgoing = #{{ on_out }}:0.65
grayIconBubble_incoming = #{{ subtext0.hex }}
grayIconBubble_outgoing = #{{ on_out }}:0.65
accentIconBubble_incoming = #{{ green.hex }}
accentIconBubble_outgoing = #{{ on_out }}
linkBubble_incoming = #{{ lnk }}
linkBubble_outgoing = #{{ on_out }}
redBubble_incoming = #{{ red.hex }}
redBubble_outgoing = #{{ on_out }}
greenBubble_incoming = #{{ green.hex }}
greenBubble_outgoing = #{{ on_out }}
selectMessageBubble = #{{ surface1.hex }}:0.5

//Files, voice, previews
fileActivityBackground = #{{ green.hex }}
fileActivityForeground = #{{ on_accent }}
fileActivityBackgroundBubble_incoming = #{{ green.hex }}
fileActivityBackgroundBubble_outgoing = #{{ on_out }}
fileActivityForegroundBubble_incoming = #{{ on_accent }}
fileActivityForegroundBubble_outgoing = #{{ out_bg }}
waveformBackground = #{{ overlay1.hex }}
waveformForeground = #{{ green.hex }}
waveformBackgroundBubble_incoming = #{{ overlay1.hex }}
waveformBackgroundBubble_outgoing = #{{ on_out }}:0.4
waveformForegroundBubble_incoming = #{{ green.hex }}
waveformForegroundBubble_outgoing = #{{ on_out }}
webPreviewActivity = #{{ lnk }}
webPreviewActivityBubble_incoming = #{{ lnk }}
webPreviewActivityBubble_outgoing = #{{ on_out }}

//Replies
chatReplyTitle = #{{ lnk }}
chatReplyTextEnabled = #{{ text.hex }}
chatReplyTextDisabled = #{{ subtext0.hex }}
chatReplyTitleBubble_incoming = #{{ lnk }}
chatReplyTitleBubble_outgoing = #{{ on_out }}
chatReplyTextEnabledBubble_incoming = #{{ text.hex }}
chatReplyTextEnabledBubble_outgoing = #{{ on_out }}
chatReplyTextDisabledBubble_incoming = #{{ subtext0.hex }}
chatReplyTextDisabledBubble_outgoing = #{{ on_out }}:0.65

//Peer names and avatars
groupPeerNameRed = #{{ red.hex }}
groupPeerNameOrange = #{{ peach.hex }}
groupPeerNameViolet = #{{ mauve.hex }}
groupPeerNameGreen = #{{ green.hex }}
groupPeerNameCyan = #{{ teal.hex }}
groupPeerNameLightBlue = #{{ sky.hex }}
groupPeerNameBlue = #{{ blue.hex }}
peerAvatarRedTop = #{{ red.hex }}
peerAvatarRedBottom = #{{ maroon.hex }}
peerAvatarOrangeTop = #{{ yellow.hex }}
peerAvatarOrangeBottom = #{{ peach.hex }}
peerAvatarVioletTop = #{{ lavender.hex }}
peerAvatarVioletBottom = #{{ mauve.hex }}
peerAvatarGreenTop = #{{ green.hex }}
peerAvatarGreenBottom = #{{ teal.hex }}
peerAvatarCyanTop = #{{ sky.hex }}
peerAvatarCyanBottom = #{{ teal.hex }}
peerAvatarBlueTop = #{{ sapphire.hex }}
peerAvatarBlueBottom = #{{ blue.hex }}
peerAvatarPinkTop = #{{ pink.hex }}
peerAvatarPinkBottom = #{{ flamingo.hex }}

//Swipe actions
revealAction_neutral1_background = #{{ blue.hex }}
revealAction_neutral1_foreground = #{{ on_accent }}
revealAction_neutral2_background = #{{ peach.hex }}
revealAction_neutral2_foreground = #{{ on_accent }}
revealAction_destructive_background = #{{ red.hex }}
revealAction_destructive_foreground = #{{ on_accent }}
revealAction_constructive_background = #{{ green.hex }}
revealAction_constructive_foreground = #{{ on_accent }}
revealAction_accent_background = #{{ green.hex }}
revealAction_accent_foreground = #{{ on_accent }}
revealAction_warning_background = #{{ peach.hex }}
revealAction_warning_foreground = #{{ on_accent }}
revealAction_inactive_background = #{{ surface1.hex }}
revealAction_inactive_foreground = #{{ text.hex }}

//Misc
chatDateActive = #{{ surface0.hex }}
chatDateText = #{{ text.hex }}
listBackground = #{{ mantle.hex }}
listGrayText = #{{ subtext0.hex }}
grayHighlight = #{{ surface0.hex }}
focusAnimationColor = #{{ green.hex }}
//Parameter is usually using for minimalistic chat mode, but also works as fallback for bubbles if wallpaper not installed
chatBackground = #{{ base.hex }}
//Parameter only affects bubble chat mode. Available values: none, builtin, hexColor or url to cloud backgound like a t.me/bg/%slug%
wallpaper = #{{ base.hex }}

  muteIcon: 66{{ text.hex }}
  unreadBadgeActiveBg: {{ green.hex }}
  unreadBadgeActiveText: {{ crust.hex }}
  unreadBadgeInactiveBg: 66{{ text.hex }}
  unreadBadgeInactiveText: {{ base.hex }}
  reactionBadgeActiveBg: {{ red.hex }}
  pinnedBadge: 80{{ text.hex }}
  pinnedSearchBar: {{ base.hex }}
  regularSearchBar: {{ surface0.hex }}
  sectionHeaderBg: {{ surface0.hex }}
  sectionHeaderText: 80{{ text.hex }}
  verifiedIconBg: {{ green.hex }}
  verifiedIconFg: {{ text.hex }}
  secretIcon: {{ green.hex }}
  pinnedArchiveAvatar:
    background:
      top: {{ blue.hex }}
      bottom: {{ blue.hex }}
    foreground: {{ text.hex }}
  unpinnedArchiveAvatar:
    background:
      top: {{ surface2.hex }}
      bottom: {{ surface2.hex }}
    foreground: {{ base.hex }}
  onlineDot: {{ green.hex }}
  storyUnseen:
    top: {{ green.hex }}
    bottom: {{ sapphire.hex }}
  storyUnseenPrivate:
    top: {{ green.hex }}
    bottom: {{ teal.hex }}
  storySeen:
    top: {{ surface2.hex }}
    bottom: {{ surface2.hex }}
chat:
  defaultWallpaper: {{ base.hex }}
  animateMessageColors: false
  message:
    incoming:
      bubble:
